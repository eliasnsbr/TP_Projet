def affichage(N,A,X,eps):
    x, y = np.linspace(-4,4,N), np.linspace(-4,4,N)
    z = [0 for i in range(n-1)]
    C = np.zeros((N, N))
    
    rounded_eigs = np.round(Rt[0], 1)
    for i in range(N):
        for j in range(N):
            X = np.array([[x[i],y[j]]+z])
            B = newton(A, X, 1e-3)[0][n]
            if np.round(B,1) in rounded_eigs :
                C[i][j] = B
            else :
                #print(B)
                C[i][j] = C[i][j-1]
    nm = name()
    plt.imsave(nm, C)
    return C

def name():
    nm = str(n) + "x" + str(n) + "_" + str(N) + "__A_"
    for e in A:
        for f in e:
            nm += "-" + str(f)
    nm += "__vp_"
    for e in Rt[0]:
        nm += "_" + str(round(e,3))
    nm += ".png"
    return nm

