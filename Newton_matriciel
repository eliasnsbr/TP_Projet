        #F = np.block([[F1], [F2]])
        F = np.block([[A-x[2]*np.identity(2), -V], [2* np.transpose(V), 0]])
        #print(F, la.det(F))
        if la.det(F) != 0:
            #print(la.det(F))
            #print(np.shape(la.inv(F)),np.shape(fonction(x)))
            X = x - np.matmul(la.inv(F),fonction(x))
            delta = la.norm(X-x)
            x = X
            #print(delta)
        else:
            print("BIOS error")
            return [0,0,0] #"T'es fou ? C'est pas inversible ! Grand malade, va"
    return X


