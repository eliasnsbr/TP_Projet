def mat_sym_def_pos(n):
    A = np.zeros((n,n))
    for i in range(n):
        A[i,i] = rd.rand()*10
        for j in range(i,n):
            A[i,j] = rd.rand()
            A[j,i] = A[i,j]
    if min(la.eig(A)[0]) < 0:
        A += min(la.eig(A)[0])*np.identity(n)
    return A

