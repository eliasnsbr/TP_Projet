import numpy as np
import numpy.linalg as la
import numpy.random as rd
import matplotlib.pyplot as plt
import time as t

n = 4

def mat_sym_def_pos(n):
    A = np.zeros((n,n))
    for i in range(n):
        A[i,i] = rd.rand()*10
        for j in range(i,n):
            A[i,j] = rd.rand()
            A[j,i] = A[i,j]
    if min(la.eig(A)[0]) < 0:
        A -= 2*min(la.eig(A)[0])*np.identity(n)
    return A

def fonction(A, X):
    n = len(A)
    V = X[0][:n].reshape(1, -1)
    top = (X[0][n] * np.eye(n) - A) @ V.T
    bottom = 0.5 * (V @ V.T) - 1
    return np.vstack((top, bottom))

def jacobienne(A, X, k):
    n = len(A)
    V = X[0][:n].reshape(1, -1)
    top = np.hstack((X[0][n]*np.eye(n) - A, V.T))
    bottom = np.hstack((V, np.zeros((1, 1))))
    return np.vstack((top, bottom))

def newton(A, X, eps):
    x = X
    delta = float('inf')
    k = 0
    while delta > eps and k < 10:
        J = jacobienne(A, x, k)
        G = fonction(A, x)
        try:
            dx = np.transpose(la.solve(J, G))
        except la.LinAlgError:
            print("Singular Jacobian matrix encountered.")
            return None
        y = x - dx
        delta = la.norm(y - x)
        x = y
        k += 1
    return x

A = mat_sym_def_pos(n)
Rt = la.eig(A)

X = np.array([[rd.rand() for i in range(n+1)]])
