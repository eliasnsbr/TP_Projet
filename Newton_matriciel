def fonction(A,X):
    n = len(A)
    V = np.array([[e for e in X[0][:n]]])
    Ri = np.block([[np.matmul(A-X[0][n]*np.identity(n),np.transpose(V))], [np.matmul(V,np.transpose(V))-1]])
    R = np.array([e for e in Ri])
# =============================================================================
#     print(V)
#     print(np.shape(V))
#     print(np.shape(R))
# =============================================================================
    return R

