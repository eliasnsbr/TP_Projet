def fonction(X):
    x = A[0,0]*X[0] + A[1,0]*X[1] - X[0]*X[2]
    y = A[0,1]*X[0] + A[1,1]*X[1] - X[1]*X[2]
    z = X[0]**2 + X[1]**2 - 1
    return np.array([x,y,z])

def newton(x, eps):
    delta = 1
    while delta > eps :
        V = np.array([[x[0]],[x[1]]])
        #print(np.shape(A),np.shape(V),np.shape(np.identity(2)),np.shape(A-x[2]*np.identity(2)))
        #F1 = np.block([A-x[2]*np.identity(2), -V])
