import cmath
import numpy as np
#import numpy.linalg as la
import matplotlib.pyplot as plt
import time as t

epsilon_m = np.finfo(np.float64).eps
n = 8
def function(z):
    return z**n - 1

def derivative(x):
	epsilon = 1e-6
	return (function(x+epsilon)-function(x))/epsilon

def newton(a,eps):
    delta = 1
    while delta > eps :
        x = a - function(a)/(derivative(a)+epsilon_m)
        delta = abs(x - a)
        a = x
    return x

T = t.time()
#print(newton(3+1j, 1e-4))
N = 10000
