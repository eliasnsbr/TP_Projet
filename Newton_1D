import numpy as np
import np.linalg as la
import matplotlib.pyplot as plt

epsilon = np.finfo().eps

def newton(a,eps):
    delta = 1
    while delta > eps:
        x = -function(a)/derivative(a) + a
        delta = abs(x - a)
        a = x
    return x , delta

def function(x):
    return 0.1*x**3-x+1

def derivative(x):
    return (function(x+epsilon)-function(x))/epsilon

print(newton(0, 0.001))
